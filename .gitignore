# Archived / superseded material -- not part of the live pipeline
archive/

# Generated per-option CSV detail -- fully reproducible via
# `python analysis/haplotype_options_report/run.py`; only the top-level
# summary.csv / samples_overview.csv (and phasing_equivalence_classes.csv)
# per sample are checked in.
analysis/haplotype_options_report/*/option_*/
analysis/haplotype_options_report/.overview/
analysis/case_studies/*/selected_phasing/scenarios_summary.csv
analysis/case_studies/*/.phasings.pkl

# Run logs and per-sample intermediate outputs of scripts/reproduce_all.sh
logs/
repro/
benchmark/results/

# Large raster renders; the PDF/HTML versions of each figure are checked in
paper_outputs/figures/*/scenario.png

# Paper-writing scratch (figure planning docs, not analysis output)
Output/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# IDE / tooling
.idea/

